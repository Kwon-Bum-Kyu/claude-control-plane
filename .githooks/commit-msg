#!/bin/sh
# Commit messages are published along with the tree, so scan them too.
# Convenience only: --no-verify bypasses this.
if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node was not found on PATH, so the boundary checks cannot run." >&2
  echo "commit-msg: install node, or bypass deliberately with --no-verify." >&2
  exit 1
fi
exec node "$(git rev-parse --show-toplevel)/tools/repo-guard.mjs" content --commit-msg "$1"
