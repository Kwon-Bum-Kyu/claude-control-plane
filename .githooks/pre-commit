#!/bin/sh
# Scan the staged content before it becomes a commit.
# Convenience only: --no-verify bypasses this, and CI is what enforces the boundary.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node was not found on PATH, so the boundary checks cannot run." >&2
  echo "pre-commit: install node, or bypass deliberately with --no-verify." >&2
  exit 1
fi
exec node "$(git rev-parse --show-toplevel)/tools/repo-guard.mjs" content --staged
